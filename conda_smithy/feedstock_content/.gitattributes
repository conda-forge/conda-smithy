* text=auto

*.patch binary
*.diff binary
meta.yaml text eol=lf
build.sh text eol=lf
bld.bat text eol=crlf

# github helper pieces to make some files not show up in diffs automatically
# everything is generated by conda-smithy except for the recipe and conda-forge.yml
* linguist-generated=true
/recipe/** linguist-generated=false
/conda-forge.yml linguist-generated=false
